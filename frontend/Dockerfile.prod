# ==============================================================================
# 生产运行时镜像（薄构建）
# 只负责托管本地预构建好的 dist（frontend/pnpm run build 的产物），
# 不在服务器上跑 Node 构建。产物由 scripts/deploy-tc-cloud.sh 同步。
# 完整的多阶段构建见同目录 Dockerfile（CI / 通用场景使用）。
# ==============================================================================
FROM nginx:alpine

COPY dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf

# 自签 TLS 证书（由 deploy-tc-cloud.sh 从 frontend/certs/ 同步；该目录在 .gitignore 中）
COPY certs /etc/nginx/certs

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
